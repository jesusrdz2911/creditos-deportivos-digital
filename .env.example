# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.
# Clave que firma los sellos digitales de las constancias (usa una cadena larga y aleatoria).
SELLO_SECRET=
# Clave de sesiones de Flask.
SECRET_KEY=
# Direccion publica del sitio, para que el QR apunte a la verificacion (ej. https://mi-app.onrender.com)
BASE_URL=http://localhost:5000
